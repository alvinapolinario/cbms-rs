# Used directly by `cargo run` on the host (via the sabonglara-mysql container's forwarded
# host port). Not used inside Docker -- see DB_USERNAME/DB_PASSWORD/DB_DATABASE below.
DATABASE_URL=mysql://sabong_root:sabong_pass@127.0.0.1:3309/sabong_lara_db

# Same values as the sibling sabonglara (Laravel) repo's own .env. docker-compose.yml uses
# these to build the container-internal DATABASE_URL (mysql:3306, container DNS name) --
# this container joins that repo's `sabonglara_default` network to reach it.
DB_USERNAME=sabong_root
DB_PASSWORD=sabong_pass
DB_DATABASE=sabong_lara_db

# Host port this container's nginx is published on (kept different from the Laravel app's own
# APP_PORT so both can run side by side for response diffing).
APP_PORT=8081

# Bind address for the HTTP server.
HOST=0.0.0.0
PORT=8080

# Bridge to sabong-matching-system (must match that app's MATCHING_TO_BETTING_KEY /
# BETTING_TO_MATCHING_KEY exactly -- both apps share these two secrets).
MATCHING_BRIDGE_ENABLED=false
MATCHING_BRIDGE_URL=http://sabong-app:3000
MATCHING_TO_BETTING_KEY=
BETTING_TO_MATCHING_KEY=

# Business limits (same defaults as config/betting.php).
BET_MIN=1
BET_MAX=1000000
CASH_MAX=1000000
API_TOKEN_HOURS=18
REQUIRE_CLOSED_BEFORE_RESULT=true
# Sabong2026 BetController@store hardcodes 7 digits. Override only for experiments.
RECEIPT_RANDOM_DIGITS=7

# Print service. Same value as Laravel PRINT_SERVICE_KEY and the FastAPI LARAVEL_PRINT_KEY.
# Leave empty to make /api/print-service/* answer 503.
PRINT_SERVICE_KEY=

# Realtime: trigger the existing beyondcode/laravel-websockets server (keep that PHP
# process running -- see docs/WORKFLOW.md section 9 -- this app only POSTs events into it).
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_ID=local
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=local
